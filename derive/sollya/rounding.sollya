/* Bounds on what binary64 arithmetic does to the settle.
 *
 * Run: sollya derive/sollya/rounding.sollya | grep -x 'all certificates hold'
 * (Sollya's quit takes no status, so the verdict is the last line)
 *
 * The bounds below are intervals, evaluated with outward rounding at 300
 * bits. A comparison takes the end that makes it safe: the upper end against
 * a ceiling, the lower end against a floor. Inputs and thresholds are rounded
 * to 300 bits once, far finer than any margin checked, so a printed "ok" is
 * not a floating-point estimate.
 *
 * u is the unit roundoff of binary64, and gamma(k) = k u / (1 - k u) is
 * Higham's gamma (Accuracy and Stability of Numerical Algorithms, 2nd ed.,
 * Lemma 3.1). A k-term dot product of nonnegative terms carries at most
 * gamma(k) relative error (his section 3.1).
 */

prec = 300!;
display = decimal!;

u = 2^(-53);
eps = 2^(-52);
failures = 0;

gamma = proc(k) {
  return [k] * u / ([1] - [k] * u);
};

/* 1. The tolerance, from the floor a settle's residual cannot go below.
 *
 * One computed Friedkin-Johnsen step on opinions in [0, 1] differs from the
 * exact step by at most gamma(n + 2). The n + 2 cover a dot product of n
 * terms, a product with s_i and the added anchor term. Computed iterates
 * satisfy |x_t - x*| <= (q |x_t - x_(t-1)| + gamma(n + 2)) / (1 - q).
 * Rounding adds gamma(n + 2) / (1 - q) to Banach's bound, and settle_with
 * counts that term. It grows with n and with q, so over the panels the
 * default is derived for, n <= SUPPORTED_VOTERS = 2^25 - 1 and
 * q <= CONTRACTION_BOUND = 1/2, the corner is the worst case.
 * Opts::default sets tol to twice the floor there, 4 gamma(2^25 + 1), in
 * binary64 with one rounding, in the quotient of gamma. */
floor_of = proc(n, q) {
  return gamma(n + 2) / ([1] - [q]);
};
voters = 2^25 - 1;
corner = floor_of(voters, 1/2);
ku = (voters + 2) * u;
tol = 4 * D(ku / (1 - ku));
print("1. rounding floor at", voters, "voters and q = 1/2:", sup(corner), "; tol:", tol);
if tol == D(1.490116169344802e-08) && sup(abs(tol - 2 * corner)) <= tol * u then
  print("   ok: Opts::default's tol is twice the worst floor, rounded once to binary64")
else {
  print("   FAIL: tol is not twice the floor at the corner");
  failures = failures + 1;
};

/* 2. The round cap. The first step is s_i (W x0 - x0), so it moves no
 * opinion by more than q, the t-th step is at most q^t, and Banach's term
 * q / (1 - q) times it is at most q^(t + 1) / (1 - q). That rises with q,
 * so over q <= 1/2 it is at most 2^-t, and after t rounds the bound is at
 * most 2^-t plus the floor. max_iter is the least t that puts it under tol
 * on every such panel. A settle with q above the bound gets the count
 * fj_rounds_to_tol names in its note, 1 + ceil(ln tol / ln q). */
after = proc(t) {
  return [2]^(-t) + corner;
};
if sup(after(27)) < tol && inf(after(26)) >= tol then
  print("2. the bound after 27 rounds is at most", sup(after(27)), "under tol, and after 26 at least", inf(after(26)), "\n   ok: max_iter 27 certifies every panel with q <= 1/2 and up to", voters, "voters")
else {
  print("2. FAIL: 27 is not the least round count that reaches tol at q = 1/2");
  failures = failures + 1;
};
for q in [|7/10, 9/10, 99/100|] do
  print("   q =", q, ": the note names", 1 + ceil(sup(log([tol]) / log([q]))), "rounds");

/* 3. The tie allowance. outcome_of sums each option's n opinions, sums the
 * m option sums into a total, and divides. Counting the roundings as in
 * Higham's Lemma 3.1, a share then carries at most gamma(2 n + m - 2)
 * relative error. Two shares sum to at most one, so a margin is off by at
 * most that much. An option needs a ballot and a voter casts one, so m <= n,
 * and gamma(3 n - 2) bounds every margin. outcome_of allows 4 n eps = 8 n u,
 * and over u the difference is 5 n + 2 - (3 n - 2) b / (1 - b), where
 * b = (3 n - 2) u. The check takes each doubling of n up to 2^40 voters as
 * one interval, which keeps the overestimate small. */
least = 2^60;
for j from 0 to 39 do {
  nn = [2^j; 2^(j + 1)];
  b = (3 * nn - 2) * u;
  over_u = 5 * nn + 2 - (3 * nn - 2) * b / (1 - b);
  if inf(over_u) < least then least = inf(over_u);
};
print("3. (4 n eps - gamma(3 n - 2)) / u over n in [1, 2^40] is at least", least);
if least > 0 then
  print("   ok: the tie allowance covers the rounding of every share")
else {
  print("   FAIL: the tie allowance does not cover the share rounding");
  failures = failures + 1;
};

/* 4. What a record reads as. Dawid-Skene's Laplace smoothing, and the rule
 * of succession shrunk_accuracy reads a record by, give a voter seen N
 * times the accuracy (h + 1) / (N + 2), h its hits, so its log odds lie in
 * [-ln(N + 1), ln(N + 1)] and no voter's weight runs away on a short
 * record. h = 0 and h = N give the ends. The clamp to
 * [TRUST_FLOOR, 1 - TRUST_FLOOR], TRUST_FLOOR = 2^-52, binds only from a
 * perfect record of N = 2^52 - 2, where (N + 1) / (N + 2) >= 1 - 2^-52. */
big = 10^6;
lo = log(([1] / [big + 2]) / ([big + 1] / [big + 2]));
gap = sup(abs(lo + log([big + 1])));
print("4. the log odds of a record of 10^6 misses is", inf(lo), "within", gap, "of -ln(10^6 + 1)");
binds = proc(n) {
  return (n + 1) * 2^52 >= (2^52 - 1) * (n + 2);
};
if gap < 1e-80 && binds(2^52 - 2) && binds(2^52 - 3) == false then
  print("   ok: |logit| <= ln(N + 1); the clamp at 2^-52 binds from a perfect record of 2^52 - 2")
else {
  print("   FAIL: the record bound");
  failures = failures + 1;
};

if failures == 0 then print("all certificates hold")
else print(failures, "certificates failed");
quit;
